# Copy to an untracked .env.nas and replace all host paths/UID/GID.
# NAS architecture is selected by the amd64/arm64 image manifest.
CLIPLINE_IMAGE_NAME=evanqu/clipline
# Latest verified main image; pin an existing X.Y.Z or digest for production.
CLIPLINE_IMAGE_TAG=latest
CLIPLINE_UID=1000
CLIPLINE_GID=1000
CLIPLINE_DATA_DIR=./data
CLIPLINE_RECORDINGS_DIR=/path/to/recordings
CLIPLINE_HTTP_BIND=0.0.0.0
CLIPLINE_HTTP_PORT=8088
# Optional hard limits; 0 keeps Docker defaults. Shared 2 GiB hosts can use
# CPU_LIMIT=1, MEMORY_LIMIT=768m. Configure media settings in the application.
CLIPLINE_CPU_LIMIT=0
CLIPLINE_MEMORY_LIMIT=0
