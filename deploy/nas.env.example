# Copy to an untracked .env.nas and replace all host paths/UID/GID.
# NAS architecture is selected by the amd64/arm64 image manifest.
CLIPLINE_IMAGE_NAME=evanqu/clipline
# Candidate application version; use only after its release workflow succeeds.
CLIPLINE_IMAGE_TAG=0.7.0
CLIPLINE_UID=1000
CLIPLINE_GID=1000
CLIPLINE_DATA_DIR=/volume1/docker/clipline/data
CLIPLINE_RECORDINGS_DIR=/volume1/recordings
CLIPLINE_HTTP_BIND=0.0.0.0
CLIPLINE_HTTP_PORT=8088
CLIPLINE_MEDIA_THREADS=2
CLIPLINE_MAX_CONCURRENT_TRANSCODES=1
CLIPLINE_EXPORT_FPS=25
CLIPLINE_EXPORT_MAX_WIDTH=3840
CLIPLINE_PLAYBACK_MAX_WIDTH=1920
CLIPLINE_EXPORT_TTL_HOURS=24
CLIPLINE_LOG_RETENTION_DAYS=30
CLIPLINE_PLAYBACK_CACHE_MAX_BYTES=2147483648
# Optional hard limits; 0 keeps Docker defaults. Shared 2 GiB hosts can use
# CPU_LIMIT=1, MEMORY_LIMIT=768m, MEDIA_THREADS=1, PLAYBACK/EXPORT_MAX_WIDTH=1280.
CLIPLINE_CPU_LIMIT=0
CLIPLINE_MEMORY_LIMIT=0
