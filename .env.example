# Clipline 环境变量配置示例

# 基础配置
TZ=Asia/Shanghai
CLIPLINE_HTTP_PORT=8080
CLIPLINE_DATA_HOST=./data
CLIPLINE_RECORDINGS_HOST=./recordings

# 录像配置
CLIPLINE_RECORDINGS_ROOT=/recordings
CLIPLINE_SKIP_RECENT_SECONDS=30
CLIPLINE_MAX_EXPORT_MINUTES=30

# ASR 语音识别配置
# 模型选择: funasr / sensevoice / whisper
CLIPLINE_ASR_MODEL=funasr

# 模型大小: tiny / base / medium / large
# tiny: 最快，准确度低
# base: 平衡
# medium: 推荐，准确度高
# large: 最准，速度慢
CLIPLINE_ASR_MODEL_SIZE=medium

# 运行设备: auto / cpu / cuda / mps
# auto: 自动选择
# cpu: CPU 运行
# cuda: NVIDIA GPU 加速
# mps: Apple Silicon 加速
CLIPLINE_ASR_DEVICE=auto

# 识别语言: zh / en / mixed
# zh: 中文
# en: 英文
# mixed: 中英混合
CLIPLINE_ASR_LANGUAGE=zh

# 自动识别新视频: true / false
# 开启后，扫描到新视频会自动触发语音识别
CLIPLINE_ASR_AUTO_TRANSCRIBE=false

# 热词配置（逗号分隔）
# 可以提高特定词汇的识别准确度
# 例如：人名、地名、专业术语等
CLIPLINE_ASR_HOTWORDS=张三,李四,公司名
